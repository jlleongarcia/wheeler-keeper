# Django Settings
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# Configuración de Base de Datos
DB_NAME=wheeler_keeper_db
DB_USER=wheeler_keeper_user
DB_PASSWORD=wheeler_keeper_password
DB_HOST=db
DB_PORT=5432

# Configuración de Email (Opcional)
# Para notificaciones de nuevos registros
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-password-de-aplicacion
DEFAULT_FROM_EMAIL=Wheeler Keeper <noreply@wheelerkeepr.com>
ADMIN_EMAIL=admin@tudominio.com

# Configuración para desarrollo (Sin email real)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración de Seguridad (Producción con HTTPS)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Google OAuth (Configurar en producción)
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret
SECRET_KEY=tu-secret-key-super-segura-aqui