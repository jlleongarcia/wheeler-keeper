# Django settings
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
DEBUG=False

# Database settings
DB_NAME=wheeler_keeper_db
DB_USER=wheeler_keeper_user
DB_PASSWORD=wheeler_keeper_password
DB_HOST=db
DB_PORT=5432

# Email configuration (para recibir notificaciones reales)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Para desarrollo sin email real:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-password-de-aplicacion
ADMIN_EMAIL=admin@tudominio.com
DEFAULT_FROM_EMAIL=Wheeler Keeper <noreply@wheelerkeepr.com>

# Cookies seguras (True solo si accedes siempre por HTTPS;
# con True, el login por http://IP:puerto deja de funcionar)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Google OAuth (fuente de verdad; sincronizar a la BD con:
# python manage.py set_google_credentials)
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret
